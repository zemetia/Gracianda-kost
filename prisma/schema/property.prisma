// How electricity is charged for a unit.
//   FREE    — included in the rent, nothing extra is ever billed
//   TOKEN   — prepaid; the tenant buys their own token, the kost bills nothing
//   METERED — postpaid non-token; the admin reads the meter and the period is
//             billed kWh × tarif (Setting `electricity.tariffPerKwh`)
// Only METERED ever adds a line to an invoice — the other two exist so the
// admin can see at a glance which units still need a meter reading.
enum ElectricityMode {
  FREE
  TOKEN
  METERED
}

enum PropertyType {
  KOST
  HOUSE
  APARTMENT
  VILLA
  OTHER
}

// Who the property accepts. CAMPUR means both, which is also the safe default
// for non-kost types (a whole house or villa has no gender rule).
enum GenderPolicy {
  PUTRA
  PUTRI
  CAMPUR
}

model Property {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  description String?
  type        PropertyType @default(KOST)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ── Lokasi ──────────────────────────────────────────────────────────────
  // `address` is the street line only (jalan, nomor, RT/RW); the
  // administrative levels are separate columns so lists can filter by city
  // and the public page can print a proper postal address. Format the whole
  // thing with formatPropertyAddress() — never concatenate ad hoc.
  address    String?
  district   String? // Kecamatan
  city       String? // Kota / Kabupaten
  province   String?
  postalCode String?
  // Coordinates are for a map pin; `mapsUrl` is the shareable link an admin
  // pastes from Google Maps. Either can exist without the other.
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  mapsUrl    String?

  // ── Kontak penanggung jawab ─────────────────────────────────────────────
  // Per property, not per company: a portfolio can have a different penjaga
  // per building. siteConfig stays the brand-level fallback.
  contactName    String?
  contactPhone   String?
  whatsappNumber String?
  contactEmail   String?

  // ── Aturan & operasional ────────────────────────────────────────────────
  genderPolicy GenderPolicy @default(CAMPUR)
  // "22:00" style, stored as text — it is a wall-clock house rule, not an
  // instant, so a DateTime would only invite timezone bugs.
  curfewTime   String?
  rules        String?

  floors      Floor[]
  rooms       Room[]
  roomTypes   RoomType[]
  maintenance MaintenanceRecord[]
  incidents   Incident[]
  expenses    Expense[]
  facilities  PropertyFacility[]

  @@map("properties")
}

model PropertyFacility {
  propertyId String
  facilityId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([propertyId, facilityId])
  @@map("property_facilities")
}

model Floor {
  id         String   @id @default(cuid())
  name       String
  order      Int
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  rooms Room[]

  @@map("floors")
}

model Room {
  id          String   @id @default(cuid())
  number      String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  floorId     String?
  floor       Floor?    @relation(fields: [floorId], references: [id])
  roomTypeId  String?
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id])
  price       Decimal  @db.Decimal(12, 2)
  // Authoritative for billing, like `price` — the type only prefills the form.
  electricityMode ElectricityMode @default(FREE)
  // Dimensions, not total area — the admin types "3 m x 4 m", not a sqm total.
  lengthM     Decimal? @db.Decimal(5, 2)
  widthM      Decimal? @db.Decimal(5, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facilities  RoomFacility[]
  contracts   Contract[]
  maintenance MaintenanceRecord[]
  incidents   Incident[]
  prices      RoomPrice[]

  @@unique([propertyId, number])
  @@map("rooms")
}

// Room status (available/occupied) is NOT stored here — derived at the
// service layer from whether the room has an active Contract (see
// contractService / roomService.list / publicRoomService).

// A shared template for rooms that are physically identical (Tipe A, Tipe
// Deluxe, …). Two resolution rules, both implemented in resolveRoom*() in
// room.service.ts — never re-derive them ad hoc:
//   - facilities & photos: the ROOM OVERRIDES the type. A room with zero
//     rows of its own inherits the type's; one row of its own means the
//     type is ignored entirely for that dimension.
//   - price & electricityMode: the type is only a DEFAULT that prefills the
//     room form. Room.price / RoomPrice / Room.electricityMode stay the single
//     source of truth for billing.
model RoomType {
  id          String   @id @default(cuid())
  name        String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  description String?
  // Dimensions, not total area — the admin types "3 m x 4 m", not a sqm total.
  lengthM     Decimal? @db.Decimal(5, 2)
  widthM      Decimal? @db.Decimal(5, 2)
  price       Decimal? @db.Decimal(12, 2)
  // A DEFAULT only, same rule as `price`: it prefills the room form and is
  // never read during billing — Room.electricityMode stays authoritative.
  electricityMode ElectricityMode @default(FREE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms      Room[]
  facilities RoomTypeFacility[]
  prices     RoomTypePrice[]

  @@unique([propertyId, name])
  @@map("room_types")
}

model RoomTypeFacility {
  roomTypeId String
  facilityId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, facilityId])
  @@map("room_type_facilities")
}

model RoomTypePrice {
  id           String       @id @default(cuid())
  roomTypeId   String
  roomType     RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle
  interval     Int          @default(1)
  price        Decimal      @db.Decimal(12, 2)

  @@unique([roomTypeId, billingCycle, interval])
  @@map("room_type_prices")
}

enum FacilityCategory {
  COMMON
  ROOM
}

model Facility {
  id       String           @id @default(cuid())
  name     String           @unique
  icon     String?
  category FacilityCategory @default(ROOM)

  rooms      RoomFacility[]
  roomTypes  RoomTypeFacility[]
  properties PropertyFacility[]

  @@map("facilities")
}

model RoomFacility {
  roomId     String
  facilityId String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([roomId, facilityId])
  @@map("room_facilities")
}

model Promo {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("promos")
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RoomPrice {
  id           String       @id @default(cuid())
  roomId       String
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle
  interval     Int          @default(1)
  price        Decimal      @db.Decimal(12, 2)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([roomId, billingCycle, interval])
  @@map("room_prices")
}
