// Jenis kelamin penghuni — dicocokkan dengan Property.genderPolicy
// (PUTRA/PUTRI/CAMPUR) sebagai peringatan saat membuat kontrak, bukan blokir.
enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum MaritalStatus {
  BELUM_MENIKAH
  MENIKAH
  CERAI
}

model Tenant {
  id        String  @id @default(cuid())
  fullName  String
  email     String?
  phone     String
  ktpNumber String  @unique

  // Identitas
  gender        Gender?
  birthPlace    String?
  birthDate     DateTime?
  maritalStatus MaritalStatus?
  // Alamat asal sesuai KTP — dipakai saat penyewa harus dipulangkan/ditagih
  // ke keluarga, jadi disimpan utuh sebagai satu blok teks.
  idAddress     String?

  occupation   String?
  // Kantor / kampus / sekolah — konteks pekerjaan itu sendiri.
  institution  String?
  vehicleType  String? // "Motor Honda Beat", "Mobil Avanza"
  vehiclePlate String?

  // Kontak darurat: satu-satunya cara menghubungi keluarga saat penyewa
  // sakit, kabur, atau menunggak — wajib ada di form, opsional di data lama.
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  isBlacklisted Boolean  @default(false)
  blacklistNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contracts Contract[]

  @@map("tenants")
}

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

// Kenapa kontrak berakhir — membedakan "penghuni benar-benar keluar" dari
// "pindah kamar" dan "perpanjang", yang di laporan penyewa artinya beda jauh.
enum ContractEndReason {
  CHECKOUT
  TRANSFER
  RENEWAL
  CANCELLED
}

model Contract {
  id           String @id @default(cuid())
  contractCode String @unique // "GH-250001"

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  status          ContractStatus @default(ACTIVE)
  rentPrice       Decimal        @db.Decimal(12, 2) // snapshot of Room.price at contract creation
  deposit         Decimal?       @db.Decimal(12, 2)
  billingCycle    BillingCycle   @default(MONTHLY)
  billingInterval Int            @default(1)
  startDate       DateTime
  endDate         DateTime?
  actualEndDate   DateTime?
  endReason       ContractEndReason?
  notes           String?

  // Renewal / room-transfer chain. Set when this contract was produced from
  // another one via "Perpanjang" or "Pindah Kamar", so the tenant's timeline
  // stays linkable instead of looking like unrelated contracts.
  previousContractId String?   @unique
  previousContract   Contract? @relation("ContractChain", fields: [previousContractId], references: [id])
  nextContract       Contract? @relation("ContractChain")

  // Deposit settlement, filled at check-out. Deposit taken but never recorded
  // as returned/deducted is the single biggest source of tenant disputes.
  depositDeduction Decimal? @db.Decimal(12, 2)
  depositRefunded  Decimal? @db.Decimal(12, 2)
  depositNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occupants ContractOccupant[]
  payments  Payment[]

  @@index([roomId, status])
  @@map("contracts")
}

// "Penghuni Tambahan" — tinggal bersama penyewa tapi bukan pemegang kontrak.
// Jumlahnya tidak dibatasi: satu kamar bisa diisi 2, 3, atau lebih orang, dan
// setiap orang tetap punya identitas sendiri karena yang dicari saat ada
// insiden adalah orangnya, bukan sekadar jumlahnya.
model ContractOccupant {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fullName   String
  relation   String? // "Suami", "Anak", "Teman", "Saudara"
  gender     Gender?
  phone      String?
  ktpNumber  String? // sengaja tidak unique — bukan pemegang kontrak
  occupation String?
  notes      String?

  @@index([contractId])
  @@map("contract_occupants")
}

// Backing store for atomic per-year contractCode generation (GH-YYNNNN).
// Incremented via a single UPSERT ... RETURNING in a transaction — see
// generateContractCode() in src/services/contract.service.ts. This achieves
// the same race-safety as a native Postgres sequence without needing a new
// sequence object created per calendar year.
model ContractSequence {
  propertyId String
  year       Int
  lastValue  Int    @default(0)

  @@id([propertyId, year])
  @@map("contract_sequences")
}
