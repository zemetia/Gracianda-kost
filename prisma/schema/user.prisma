model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(OPERASIONAL)
  // Soft delete — a user with AuditLog rows can never be hard-deleted (FK restrict),
  // and keeping the row keeps historical audit entries attributable.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  reminders PaymentReminder[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OPERASIONAL
  KEUANGAN
  SECURITY
}
