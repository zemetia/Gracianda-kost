// status is NOT stored — derived in paymentService.getPaymentStatus() from
// amountPaid/amountDue/dueDate vs today, so a stale cron/manual step can
// never leave a payment showing the wrong status.
model Payment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  // periodStart is the real identity of a billing period. A DAILY or WEEKLY
  // contract has several periods inside one calendar month, which the old
  // @@unique([contractId, periodMonth, periodYear]) made impossible to store —
  // that is why those cycles were skipped by the invoice generator entirely.
  // periodMonth/periodYear stay as denormalized report keys: the dashboard and
  // laporan keuangan aggregate on them.
  periodStart DateTime
  periodEnd   DateTime
  periodMonth Int // 1-12
  periodYear  Int

  amountDue  Decimal   @db.Decimal(12, 2)
  amountPaid Decimal   @default(0) @db.Decimal(12, 2)
  dueDate    DateTime
  paidAt     DateTime?
  method     String? // "Transfer BCA", "Tunai"
  note       String?

  reminders PaymentReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, periodStart])
  @@index([periodYear, periodMonth])
  @@index([dueDate])
  @@map("payments")
}

// Jejak penagihan: tanpa ini admin tidak tahu siapa yang sudah ditagih hari ini
// dan mengirim WA dua kali ke orang yang sama. Ditulis saat admin menekan
// "Kirim WA" — pengiriman tetap manual lewat wa.me, server tidak mengirim apa pun.
model PaymentReminder {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String   @default("WHATSAPP")
  sentAt    DateTime @default(now())

  @@index([paymentId, sentAt])
  @@map("payment_reminders")
}
