# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MyApp

# API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Docker Compose local Postgres (docker-compose.yml) — only for local docker runs
POSTGRES_USER=gracianda
POSTGRES_PASSWORD=               # required by docker-compose.yml — local dev only, never reuse a real password
POSTGRES_DB=gracianda_kost

# NextAuth / Auth.js
AUTH_SECRET=                     # openssl rand -base64 32
AUTH_URL=http://localhost:3000   # Must match NEXT_PUBLIC_APP_URL in production

# Sentry (https://sentry.io)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
